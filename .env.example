# Kopiere diese Datei zu .env und fülle die Werte aus

# Flask-Secret (zufälliger langer String)
SECRET_KEY=change-me-to-a-long-random-string

# Admin-Login
ADMIN_USER=admin
# SHA-256-Hash des Passworts — generieren mit:
#   python3 -c "import hashlib; print(hashlib.sha256(b'DEIN_PASSWORT').hexdigest())"
ADMIN_PASS_HASH=

# Token für den Deploy-Webhook (zufälliger String)
DEPLOY_TOKEN=change-me-to-random-token
